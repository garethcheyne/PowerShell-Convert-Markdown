{
  "$schema": "https://raw.githubusercontent.com/garethcheyne/PowerShell-Convert-Markdown/main/style.schema.json",

  "name": "Example",

  "page": {
    "marginMm": 10,
    "orientation": "Portrait"
  },

  "fonts": {
    "body": "Segoe UI",
    "heading": "Segoe UI Semibold",
    "title": "",
    "mono": "Consolas",
    "bodySizePt": 10.5
  },

  "colours": {
    "accent": "#1F3864",
    "accentSoft": "#2E74B5",
    "heading": "",
    "muted": "#595959",
    "rule": "#C8102E",
    "border": "#B4C6E7",
    "band": "#F2F5FA",
    "text": "#1F1F1F",
    "h3": "",
    "link": "",
    "bullet": "",
    "code": "#A31515",
    "codeBg": "#F4F4F4",
    "codeBlockBg": "#F7F7F9"
  },

  "tables": {
    "headerStyle": "filled",
    "banded": true,
    "firstColumnBold": false
  },

  "layout": {
    "sectionBreak": "none",
    "headingRules": true,
    "h2SizePt": 14,
    "h3SizePt": 11.5,
    "contents": "none",
    "contentsKicker": "Contents",
    "contentsTitle": "What this document covers",
    "callouts": "github"
  },

  "header": {
    "left": "",
    "right": "{title}",
    "leftColour": "",
    "rightColour": "",
    "ruleColour": ""
  },

  "footer": {
    "left": "{today}",
    "right": "Page {page} of {pages}",
    "colour": ""
  },

  "cover": {
    "enabled": false,
    "logo": "",
    "logoWidthMm": 55,
    "kicker": "",
    "band": "",
    "fields": [],
    "panelFields": []
  },

  "diagrams": {
    "service": "mermaid.ink",
    "serviceUrl": "",
    "maxWidthPx": 640,
    "theme": "base",
    "matchDocumentPalette": true
  },

  "images": {
    "maxWidthPx": 640,
    "allowRemote": true
  }
}
